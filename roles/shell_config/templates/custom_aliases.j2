alias update_url='bash <(curl -sL https://raw.githubusercontent.com/tna76874/ansible-silverblue/main/setup.sh)'
alias update='silverblue-update'
update_tag() {
    local target_dir="/var/local/silverblue-setup"
    if [ ! -d "$target_dir" ]; then
        echo "Fehler: Setup-Verzeichnis nicht gefunden."
        return 1
    fi
    cd "$target_dir" || return 1
    if [ $# -eq 0 ]; then
        sudo ./venv/bin/ansible-playbook playbook.yml -c local
    else
        sudo ./venv/bin/ansible-playbook playbook.yml -c local --tags "$@"
    fi
}